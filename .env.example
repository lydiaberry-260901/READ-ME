# Copy this file to .env and fill in real values. Never commit .env.
# Every setting is explained in the README under "Settings".

# Postgres database address (user, password, host, port, database name)
DATABASE_URL="postgresql://moca:CHANGE_ME@localhost:5432/moca_crm?schema=public"
# Separate database used only by the automatic tests
TEST_DATABASE_URL="postgresql://moca:CHANGE_ME@localhost:5432/moca_crm_test?schema=public"

# Public web address of the CRM, used in links inside emails
APP_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
# Long random value used to protect sign in sessions. Create one with: npx auth secret
AUTH_SECRET="CHANGE_ME"
AUTH_TRUST_HOST="true"

# Google sign in (Google Cloud Console, OAuth client)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Microsoft sign in (Microsoft Entra, app registration)
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/common/v2.0"

# Development only. Lets you sign in as a demo user without Google or Microsoft.
# Ignored when the app runs in production.
DEV_LOGIN_ENABLED="false"

# 32 random bytes, base64. Used to encrypt stored sign in details for email and calendar.
ENCRYPTION_KEY="CHANGE_ME"
# 32 random bytes, base64. Used to store opt out addresses in a form that cannot be read back.
SUPPRESSION_HMAC_KEY="CHANGE_ME"

# Claude API key for AI summaries and drafts
ANTHROPIC_API_KEY=""
# Which Claude model to use. Leave blank for the default (claude-opus-5).
AI_MODEL=""

# Free key from the Companies House developer hub, for company details lookups
COMPANIES_HOUSE_API_KEY=""

# Demo data only: this address is invited as an Admin when you run npm run db:seed
SEED_ADMIN_EMAIL=""

# Stop Next.js sending anonymous usage statistics
NEXT_TELEMETRY_DISABLED="1"
