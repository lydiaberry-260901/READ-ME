{
  "name": "moca-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Moca sales CRM: prospects, customers, deals and follow ups.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "worker": "tsx worker/index.ts",
    "worker:dev": "tsx watch worker/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "outreach:starter": "tsx scripts/install-starter-library.ts",
    "deals:recalculate": "tsx scripts/recalculate-health.ts",
    "db:demo-activity": "tsx scripts/add-demo-activity.ts",
    "tasks:daily": "tsx scripts/run-daily-tasks.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@auth/prisma-adapter": "2.11.3",
    "@dnd-kit/core": "6.3.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "mammoth": "1.13.0",
    "next": "16.3.6",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "8.0.11",
    "papaparse": "5.7.0",
    "pg": "8.23.0",
    "pg-boss": "12.35.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "unpdf": "1.8.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/nodemailer": "8.0.2",
    "@types/papaparse": "5.5.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.4",
    "playwright-core": "1.63.0",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true
  }
}
